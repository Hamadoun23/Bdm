# Secrets
.env
.env.*
!.env.*.example

# Dumps de base — ils contiennent les données personnelles des clients
# (noms, téléphones) et les hachages de mots de passe. Ils ne doivent jamais
# être versionnés, a fortiori sur un dépôt public.
*.sql

# Backend
/backend/.venv
/backend/staticfiles
/backend/media
__pycache__/
*.py[cod]

# Frontend
/frontend/node_modules
/frontend/dist

# Divers
*.log
.DS_Store
Thumbs.db
/.idea
/.vscode
/.fleet
/.zed

# Documents métier (accès, listes nominatives) : jamais sur un dépôt public.
docs/*.docx
docs/*.xlsx
docs/*.bak
docs/~$*
