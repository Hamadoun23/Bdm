# Copier en ".env.docker" pour la stack Docker locale (Postgres/Supabase).
# Ne remplace PAS ton .env actuel (XAMPP + MySQL) : les deux environnements
# coexistent, utilise --env-file .env.docker avec docker compose pour basculer.

APP_NAME="Campagne BDM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bdm
DB_USERNAME=bdm
DB_PASSWORD=change-me-local-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# --- Postgres / Supabase (lus par docker-compose.yml, services db/meta/studio) ---
POSTGRES_DB=bdm
POSTGRES_USER=bdm
POSTGRES_PASSWORD=change-me-local-only

